# Root configuration template for A-Cube Academy
# Duplicate and configure in server/.env and client/.env

# SERVER CONFIGURATION (.env in /server)
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/acube-academy?retryWrites=true&w=majority
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@acube.academy
ADMIN_PASSWORD=AdminPass123!
S3_BUCKET=acube-materials
S3_REGION=auto
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
PRESIGNED_URL_EXPIRY=3600
MAX_FILE_SIZE=52428800

# CLIENT CONFIGURATION (.env in /client)
VITE_API_URL=/api/v1
